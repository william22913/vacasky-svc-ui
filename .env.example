# Browser-visible settings only. Never put secrets here.
# Leave empty in production so the app calls the same origin (/api/...), which
# nginx proxies to the Go service.
VITE_API_BASE_URL=

# Local development against the generated contract mock.
# VITE_API_BASE_URL=http://localhost:4010

# Enquiry placeholders for the site footer. Replace before launch.
VITE_WHATSAPP_NUMBER=6281234567890
VITE_CONTACT_EMAIL=hello@vacasky.example
